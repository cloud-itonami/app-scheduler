  },
  "component": [
    {
      "@type": "WebAPI",
      "name": "scheduler-mcp-component",
      "description": "Resource-aware AI workflow scheduler and actor auction coordinator",
      "url": "https://5dcfvsbd.etzhayyim.com/api/mcp",
      "programmingLanguage": "Go",
      "applicationCategory": "Backend",
      "runtimePlatform": "SpinApp (TinyGo)",
      "additionalProperty": [
        {
