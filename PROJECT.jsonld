          "value": "MCP JSON-RPC 2.0 / gRPC bridge"
        }
      ]
    }
  ],
  "etzhayyim:resourceBoundary": "project",
  "etzhayyim:capability": [
    "Goal-based planning",
    "Thread scheduling and escalation",
    "Blocker detection and mitigation",
    "Capability-aware actor auction orchestration"
  ],
